---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import Arrow from '@/components/Arrow.astro';
import ImageBand from '@/components/ImageBand.astro';
import { forfaits } from '@/data/forfaits';

/** Le prix d'appel est calculé : il suit toujours le forfait le moins cher. */
const prixMin = forfaits
  .filter((f) => f.prix !== null)
  .sort((a, b) => (a.prix ?? 0) - (b.prix ?? 0))[0];

/** Phrase propre à cette page, ajoutée à la description de Pure. */
const complement: Record<string, string> = {
  pure: ' Une narration épurée où chaque seconde compte.'
};

const inclus = [
  {
    titre: 'Post-production artisanale',
    texte: 'Sound design, colorimétrie cinéma, montage narratif'
  },
  {
    titre: 'Galerie privée en ligne',
    texte: 'Accès illimité, téléchargement haute qualité'
  },
  {
    titre: 'Présence discrète',
    texte: "Vous vivez votre journée, j'immortalise l'authenticité"
  }
];
---

<Base
  title="L'Univers LOREN - Cédric Raúl Films"
  description="LOREN n'est pas une prestation de mariage. C'est une évidence que vous ressentez avant même de comprendre pourquoi. Découvrez la philosophie derrière chaque film."
>
  <!-- Ouverture : la seule page centrée du site, c'est la signature -->
  <header class="tone-foret py-24 text-center md:py-36">
    <div class="wrap">
      <h1 class="hero-rise loren-titre">LOREN</h1>
      <hr class="hero-rule mx-auto my-8 w-16 !origin-center border-t" style="border-color: var(--accent)" />
      <p class="hero-rise quote muted" style="--d: 200ms">Ce que l'amour révèle au silence</p>
    </div>
  </header>

  <!-- Le texte -->
  <Section width="text">
    <div class="prose-serif">
      <p class="quote text-center" data-reveal>
        Il y a des moments qui ne se voient pas. Des regards qui disent tout sans un mot. Des
        instants suspendus où le temps retient son souffle.
      </p>

      <hr class="rule mx-auto w-16" />

      <p data-reveal>
        LOREN. Du latin <em>laurus</em> — le laurier, symbole de victoire et d'éternité. Cet arbre
        sacré d'Apollon, dieu de la lumière et des arts, incarnait ce qui triomphe du temps. Ce qui
        reste quand tout s'efface.
      </p>

      <p data-reveal>
        C'est exactement ce que je crée pour vous : une œuvre qui traverse les années, qui porte la
        lumière dorée du souvenir et la force tranquille de l'amour durable.
      </p>

      <blockquote class="rule quote border-y py-10 text-center" data-reveal>
        « Je ne filme pas pour qu'on regarde.<br class="hidden md:block" />
        Je filme pour qu'on ressente. »
      </blockquote>

      <p data-reveal>
        LOREN n'est pas une prestation, c'est une évidence. Les couples qui viennent à moi ne
        cherchent pas simplement à être filmés. Ils veulent être vus, compris, sublimés sans
        artifice. Ils veulent un film qui leur ressemble vraiment.
      </p>

      <p data-reveal>
        Mon approche est cinématographique et sensorielle. Je cherche l'invisible — ces gestes
        infimes, ces silences lourds de sens, cette lumière qui change tout. Pas le sourire parfait
        pour la caméra, mais le frisson authentique.
      </p>

      <p data-reveal>
        À la fin, vous aurez bien plus qu'une vidéo. Un halo de lumière autour de vos souvenirs. Une
        mémoire sculptée avec soin. Une trace vivante de ce jour où tout a pris son vrai sens.
      </p>

      <p data-reveal>
        <em>LOREN :</em> comme l'or qui brille discrètement. Comme le
        laurier qui couronne ce qui mérite de rester. Comme votre histoire, qui mérite l'éternité.
      </p>

      <hr class="rule mx-auto w-16" />

      <p class="muted text-right italic" data-reveal>— Cédric Raúl</p>
    </div>
  </Section>

  <ImageBand
    src="/media/video/amelie_cedric_poster.jpg"
    alt="Amelie et Cedric front contre front sous le voile, image extraite de leur film"
    caption="Amelie & Cedric"
    position="50% 30%"
  />

  <!-- Les quatre expériences : résumé, le détail est sur la page tarifs -->
  <Section tone="foret" id="forfaits">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
      <h2 data-reveal>Les quatre expériences LOREN</h2>
      <div data-reveal style="--i: 1">
        <p class="lead">
          Chaque formule porte en elle la même intention : révéler l'invisible. Seule la durée et
          l'amplitude du récit changent.
        </p>
        <a href="/tarifs-forfaits" class="link-arrow mt-6">
          À partir de {prixMin.prixLabel} · Voir tous les tarifs <Arrow />
        </a>
      </div>
    </div>

    <ul class="mt-14 md:mt-20">
      {
        forfaits.map((f) => (
          <li
            class="experience rule border-t last:border-b"
            id={f.id}
            data-reveal
          >
            <div>
              <h3 class="text-[1.625rem] md:text-[2rem]">{f.nomComplet.replace('LOREN ', '')}</h3>
              <p class="muted mt-3 text-sm">
                {f.heures ? `${f.heures} heures de ${f.presenceLoren}` : f.idealPour}
              </p>
            </div>
            <div class="max-w-[36rem]">
              <p class="font-serif text-xl leading-snug">« {f.citation} »</p>
              <p class="muted mt-4">
                {f.description}{complement[f.id] ?? ''}
              </p>
            </div>
            <div class="md:text-right">
              <p class="prix text-[1.5rem]">{f.prixLabel}</p>
              <a href={`/tarifs-forfaits#${f.id}`} class="link-arrow mt-4 text-sm">
                Voir le détail <Arrow />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Commun à toutes les formules -->
    <h3 class="mt-20 md:mt-28" data-reveal>Inclus dans toutes les expériences LOREN</h3>
    <div class="mt-8 grid gap-8 md:grid-cols-3 md:gap-12">
      {
        inclus.map((item, i) => (
          <div class="rule border-t pt-5" data-reveal style={`--i: ${i}`}>
            <h4>{item.titre}</h4>
            <p class="muted mt-2">{item.texte}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex flex-col items-start gap-5 md:mt-20 md:flex-row md:items-center md:gap-8" data-reveal>
      <Button href="/contact#contact">Discutons de votre projet</Button>
      <p class="muted text-sm">
        Ou découvrez <a href="/services" class="link">le processus créatif complet</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  .loren-titre {
    font-size: clamp(2.75rem, 1.6rem + 7vw, 5.5rem);
    letter-spacing: 0.22em;
    /* Compense l'interlettrage après la dernière lettre pour rester centré */
    margin-right: -0.22em;
  }

  .experience {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }

  @media (min-width: 900px) {
    .experience {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2.5fr);
      gap: 3rem;
      padding-block: 3.25rem;
      align-items: start;
    }
  }
</style>

---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Button from '@/components/Button.astro';
import Arrow from '@/components/Arrow.astro';
import { forfaitsById, LIVRAISON } from '@/data/forfaits';

const colonnes = [forfaitsById.pure, forfaitsById.ame, forfaitsById.infinie];
const creation = forfaitsById.creation;

/** Forfait mis en avant et libellés des boutons. */
const VEDETTE = 'infinie';
const boutons: Record<string, string> = {
  pure: 'Choisir Pure',
  ame: 'Choisir Âme',
  infinie: 'Démarrer mon projet'
};

const infos = [
  {
    titre: 'Paiement',
    lignes: ['Acompte 30% à réservation', 'Solde au plus tard le jour J', 'Virement bancaire']
  },
  {
    titre: 'Déplacements',
    lignes: ['Inclus en Île-de-France', "Côte d'Azur : +200€", 'International : sur devis']
  },
  {
    titre: 'Options',
    lignes: ['Second opérateur : +500€', 'Session engagement : +400€']
  },
  {
    titre: 'Garanties',
    lignes: ['Matériel redondant', 'Sauvegarde triple', 'Assurance RC pro']
  }
];
---

<Base
  title="Tarifs & Forfaits - Cédric Raúl Films"
  description="Découvrez les forfaits LOREN : quatre expériences cinématographiques adaptées à votre histoire. Tarifs transparents, sans frais cachés."
>
  <PageHero
    title="Tarifs"
    accent="L'univers LOREN"
    lead="Quatre expériences cinématographiques pensées pour s'adapter à votre célébration, avec des tarifs transparents."
  >
    <a href="/loren" class="link-arrow mt-6">Découvrir la philosophie LOREN <Arrow /></a>
  </PageHero>

  <!-- Les trois forfaits à prix fixe -->
  <Section>
    <div class="grid gap-6 lg:grid-cols-3 lg:gap-0">
      {
        colonnes.map((f, i) => {
          const vedette = f.id === VEDETTE;
          return (
            <article
              id={f.id}
              data-reveal
              style={`--i: ${i}`}
              class:list={[
                'forfait flex flex-col',
                vedette ? 'forfait-vedette tone-foret' : 'forfait-simple'
              ]}
            >
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-[2rem]">{f.nomComplet.replace('LOREN ', '')}</h2>
                {vedette && <span class="label accent">Le plus choisi</span>}
              </div>

              <p class="mt-6">
                <span class="muted block text-sm">À partir de</span>
                <span class="prix text-[2.5rem]">{f.prixLabel}</span>
              </p>

              <p class="mt-6 font-serif text-[1.1875rem] leading-snug">{f.tagline}</p>
              <p class="muted mt-2 text-sm">{f.idealPour}</p>

              <dl class="rule mt-8 grid grid-cols-2 gap-4 border-y py-5 text-sm">
                <div>
                  <dt class="muted">Présence</dt>
                  <dd class="mt-1 font-medium">{f.heures}h le jour J</dd>
                </div>
                <div>
                  <dt class="muted">Livraison</dt>
                  <dd class="mt-1 font-medium">{LIVRAISON}</dd>
                </div>
              </dl>

              <ul class="ticks mb-10 mt-7 text-[0.975rem] leading-snug">
                {f.inclusions.map((item) => <li>{item}</li>)}
              </ul>

              <Button href={`/contact?forfait=${f.id}#contact`} class="mt-auto w-full">
                {boutons[f.id]}
              </Button>
            </article>
          );
        })
      }
    </div>

    <!-- Création : sur devis -->
    <article
      id={creation.id}
      class="creation mt-6 grid gap-10 rounded-md p-8 md:p-12 lg:mt-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      data-reveal
    >
      <div class="flex flex-col items-start">
        <h2 class="text-[2rem]">{creation.nomComplet.replace('LOREN ', '')}</h2>
        <p class="mt-4 font-serif text-[2rem] leading-none">{creation.prixLabel}</p>
        <p class="mt-6 font-serif text-[1.1875rem] leading-snug">{creation.tagline}</p>
        <p class="muted mt-2 text-sm">{creation.idealPour}</p>
        <p class="muted mt-6 text-sm italic">Chaque projet est co-créé avec vous</p>
        <Button href={`/contact?forfait=${creation.id}#contact`} variant="ghost" class="mt-8">
          Discuter de mon projet
        </Button>
      </div>
      <ul class="ticks self-center text-[0.975rem] leading-snug sm:columns-2 sm:gap-10">
        {creation.inclusions.map((item) => <li class="break-inside-avoid">{item}</li>)}
      </ul>
    </article>
  </Section>

  <!-- Informations pratiques -->
  <Section tone="sable">
    <h2 data-reveal>Informations pratiques</h2>

    <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        infos.map((bloc, i) => (
          <div data-reveal style={`--i: ${i}`}>
            <h3 class="text-2xl">{bloc.titre}</h3>
            <ul class="muted mt-4 space-y-2">
              {bloc.lignes.map((ligne) => <li>{ligne}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBand
    title="Prêt à immortaliser"
    accent="votre histoire ?"
    text="Discutons ensemble de votre projet pour trouver le forfait idéal."
    primary={{ href: '/contact#contact', label: 'Demander un devis' }}
    secondary={{ href: '/loren', label: 'Philosophie LOREN' }}
  />
</Base>

<style>
  .forfait {
    padding: 2rem 1.75rem 2.25rem;
  }

  .forfait-simple {
    border: 1px solid var(--ligne);
    border-radius: var(--radius);
  }

  .forfait-vedette {
    border-radius: var(--radius);
  }

  .creation {
    border: 1px solid var(--ligne);
  }

  /* Sur ordinateur les trois forfaits forment un seul tableau :
     filets entre les colonnes, forfait vedette qui dépasse. */
  @media (min-width: 1024px) {
    .forfait {
      padding: 3rem 2.5rem;
    }

    .forfait-simple {
      border: 0;
      border-block: 1px solid var(--ligne);
      border-radius: 0;
    }

    .forfait-simple + .forfait-simple {
      border-left: 1px solid var(--ligne);
    }

    .forfait-vedette {
      margin-block: -1.25rem;
      padding-block: 4.25rem;
      box-shadow: 0 1.5rem 3rem -1.5rem rgb(26 37 30 / 0.45);
    }
  }
</style>

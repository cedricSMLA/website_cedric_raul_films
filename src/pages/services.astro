---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Testimonials from '@/components/Testimonials.astro';
import ImageBand from '@/components/ImageBand.astro';
import { LIVRAISON } from '@/data/forfaits';
import { DELAI_REPONSE } from '@/data/site';

const etapes = [
  {
    titre: 'Premier contact',
    repere: `Réponse sous ${DELAI_REPONSE}`,
    texte:
      "Vous remplissez le formulaire ou m'envoyez un email avec les informations essentielles : date, lieu, et quelques mots sur vous. Je vous confirme rapidement mes disponibilités et vous envoie les premières informations utiles."
  },
  {
    titre: 'Appel découverte',
    repere: 'Visio 30–45 min',
    texte:
      'Nous nous rencontrons en visio (ou en personne si vous êtes sur Paris). Nous parlons de vous, de votre journée, de ce qui est important pour vous.',
    fort: "C'est une vraie conversation, pas un questionnaire."
  },
  {
    titre: 'Préparation',
    repere: '2–4 semaines avant',
    texte:
      "Nous construisons ensemble le planning du jour J : horaires clés, lieux importants, moments à ne surtout pas manquer. Je m'adapte à votre organisation et repère les meilleurs moments pour la lumière, les cadrages et les éventuels plans drone."
  },
  {
    titre: 'Le jour J',
    repere: 'Présence discrète',
    avant: "Vous vivez votre journée, je m'occupe des images.",
    texte:
      "Je filme les regards, les réactions, les moments de complicité et les petites scènes que vous n'aurez parfois même pas vues sur le moment.",
    note: 'Drone FPV (si les conditions le permettent), caméras stabilisées 4K, plans cinéma.'
  }
];

const postProduction = [
  {
    titre: 'Le son qui vous replonge',
    texte:
      "Les rires, les applaudissements, les voix qui comptent pour vous : chaque son est nettoyé et équilibré pour que vous ayez l'impression d'y être à nouveau."
  },
  {
    titre: "L'ambiance en couleurs",
    texte:
      'Des tons plus chauds pour les moments intimes, plus lumineux pour la fête. La colorimétrie est travaillée pour rester naturelle et agréable, même des années plus tard.'
  },
  {
    titre: 'Le rythme de votre journée',
    texte:
      'Comme votre mariage alterne moments calmes et temps forts, le montage respecte ce rythme pour que le film soit vivant, sans être fatigant à regarder.'
  }
];

const livrables = [
  {
    titre: 'Film complet',
    texte:
      'Le film principal de votre journée, monté et sonorisé avec soin, que vous pourrez revoir ensemble autant de fois que vous le souhaitez.'
  },
  {
    titre: 'Teaser',
    texte:
      'Une version courte et rythmée, idéale à montrer rapidement à vos proches ou à partager sur les réseaux.'
  },
  {
    titre: 'Fichiers à conserver',
    texte:
      'Vos films livrés en fichiers haute définition, faciles à lire sur ordinateur ou téléviseur, et simples à sauvegarder sur vos propres supports.'
  }
];

const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  title="Services - Cédric Raúl Films"
  description="Films de mariage sur-mesure : un accompagnement clair à chaque étape, de notre premier échange jusqu'à la livraison de votre film."
>
  <PageHero
    title="Une expérience"
    accent="sur-mesure"
    lead="De notre premier échange jusqu'à la livraison de votre film, je vous montre simplement comment nous travaillons ensemble pour raconter votre journée."
  />

  <!-- Le déroulé, étape par étape -->
  <Section>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
      <h2 data-reveal>De la première rencontre au film final</h2>
      <p class="lead" data-reveal style="--i: 1">
        Voici comment tout se déroule, étape par étape, du premier contact à la livraison de votre film.
      </p>
    </div>

    <ol class="mt-14 md:mt-20">
      {
        etapes.map((etape, i) => (
          <li class="etape rule border-t" data-reveal>
            <span class="etape-numero" aria-hidden="true">{numero(i)}</span>
            <div>
              <h3>{etape.titre}</h3>
              <p class="accent mt-2 text-sm font-medium">{etape.repere}</p>
            </div>
            <div class="max-w-[38rem]">
              <p>
                {etape.avant && <strong class="font-medium">{etape.avant} </strong>}
                {etape.texte}
                {etape.fort && <strong class="font-medium"> {etape.fort}</strong>}
              </p>
              {etape.note && <p class="muted mt-4 text-sm italic">{etape.note}</p>}
            </div>
          </li>
        ))
      }

      <!-- Dernière étape : la post-production, détaillée -->
      <li class="etape rule border-y" data-reveal>
        <span class="etape-numero" aria-hidden="true">{numero(etapes.length)}</span>
        <div>
          <h3>Post production</h3>
          <p class="accent mt-2 text-sm font-medium">Livraison sous {LIVRAISON}</p>
        </div>
        <div class="max-w-[38rem]">
          <p>
            <strong class="font-medium">Plusieurs jours de travail minutieux</strong> pour transformer
            les images de votre journée en un film fluide, cohérent et agréable à regarder.
          </p>
          <dl class="mt-8 space-y-6">
            {
              postProduction.map((point) => (
                <div>
                  <dt class="font-serif text-[1.1875rem] leading-snug">{point.titre}</dt>
                  <dd class="muted mt-1.5">{point.texte}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-8 font-serif text-xl leading-snug">
            Ce n'est pas un simple assemblage d'images,
            <em class="accent">c'est un travail d'artisan.</em>
          </p>
        </div>
      </li>
    </ol>
  </Section>

  <ImageBand
    src="/media/video/raumane_maxime_poster.jpg"
    alt="Raumane et Maxime au coucher du soleil, image extraite de leur film"
    caption="Raumane & Maxime"
  />

  <!-- Ce que vous recevez -->
  <Section tone="foret">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
      <h2 data-reveal>Ce que vous recevez</h2>
      <p class="lead" data-reveal style="--i: 1">
        Des livrables simples et concrets pour revoir et partager votre journée.
      </p>
    </div>

    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-12">
      {
        livrables.map((item, i) => (
          <div class="rule border-t pt-6" data-reveal style={`--i: ${i}`}>
            <h3>{item.titre}</h3>
            <p class="muted mt-3">{item.texte}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Testimonials tone="sable" />

  <CtaBand
    title="Découvrez nos forfaits"
    accent="LOREN"
    text="Quatre formules claires pour que votre film corresponde à la façon dont vous voulez revivre cette journée."
    primary={{ href: '/tarifs-forfaits', label: 'Voir les tarifs' }}
    secondary={{ href: '/loren', label: 'Philosophie LOREN' }}
  />
</Base>

<style>
  .etape {
    display: grid;
    gap: 1rem;
    padding-block: 2.5rem;
  }

  .etape-numero {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (min-width: 900px) {
    .etape {
      grid-template-columns: 5rem minmax(0, 4fr) minmax(0, 7fr);
      gap: 2.5rem;
      padding-block: 3.5rem;
    }

    .etape-numero {
      font-size: 1.375rem;
      line-height: 1.5;
    }
  }
</style>

---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Testimonials from '@/components/Testimonials.astro';
import { filmPrincipal, films } from '@/data/films';
import { LOCALISATION } from '@/data/site';
---

<Base
  title="Cédric Raúl Films - Vidéaste mariage cinématographique Paris & Worldwide"
  description="Films de mariage cinématographiques qui provoquent l'émotion. Basé à Paris, disponible partout ailleurs. Drone FPV inclus."
>
  <!-- Film principal -->
  <section class="pb-16 pt-2 md:pb-24 md:pt-4">
    <div class="wrap">
      <div class="frame hero-frame" id="hero-frame">
        <video
          id="hero-video"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="metadata"
          poster={filmPrincipal.poster}
        >
          <source src={filmPrincipal.src} type="video/mp4" />
        </video>

        <!-- Mobile : la vidéo ne démarre pas seule, on l'ouvre en grand -->
        <button
          type="button"
          class="film-cue md:hidden"
          style="opacity: 1; transform: none"
          data-film-src={filmPrincipal.src}
        >
          <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
            <path d="M0 0l10 6-10 6z"></path>
          </svg>
          Voir le film
        </button>

        <!-- Ordinateur : la vidéo tourne sans le son, on peut l'activer -->
        <button
          type="button"
          id="mute-toggle"
          class="film-cue left-auto right-4 hidden md:inline-flex"
          style="opacity: 1; transform: none"
          aria-pressed="false"
        >
          Activer le son
        </button>
      </div>
      <p class="muted mt-3 text-sm">{filmPrincipal.couple}</p>

      <div class="mt-10 grid gap-8 md:mt-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
        <h1 class="hero-rise text-[clamp(1.75rem,0.9rem+4vw,3.75rem)]" style="--d: 250ms">
          Films de mariage cinématographiques
          <em class="block">qui provoquent l'émotion</em>
        </h1>
        <div class="hero-rise" style="--d: 400ms">
          <p class="lead">{LOCALISATION}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href="/contact#contact">Demander un devis</Button>
            <Button href="/tarifs-forfaits" variant="ghost">Voir les tarifs</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Grille des films -->
  <section class="pb-20 md:pb-32" aria-labelledby="titre-films">
    <div class="wrap">
      <hr class="rule" />
      <h2 id="titre-films" class="mt-12 md:mt-16" data-reveal>Les films</h2>

      <div class="mt-10 grid gap-x-8 gap-y-12 md:mt-14 md:grid-cols-2 md:gap-y-16">
        {
          films.map((film, i) => (
            <button
              type="button"
              class="film"
              data-film-src={film.src}
              data-reveal
              style={`--i: ${i % 2}`}
              aria-label={`Voir le film de ${film.couple}`}
            >
              <span class="frame block aspect-video">
                <video muted loop playsinline disablepictureinpicture preload="none" poster={film.poster}>
                  <source src={film.src} type="video/mp4" />
                </video>
                <span class="film-cue">
                  <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                    <path d="M0 0l10 6-10 6z" />
                  </svg>
                  Voir le film
                </span>
              </span>
              <span class="mt-4 flex items-baseline justify-between gap-4">
                <span class="font-serif text-xl leading-tight md:text-[1.375rem]">
                  {film.couple}
                </span>
                <span class="muted shrink-0 text-sm">{film.date}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <Testimonials tone="foret">
    <div
      class="rule mt-16 flex flex-col gap-8 border-t pt-10 md:flex-row md:items-center md:justify-between"
      data-reveal
    >
      <p>
        <span class="muted">Publié dans</span>
        <a
          href="https://www.lasoeurdelamariee.com/mariage-moderne-a-paris/"
          target="_blank"
          rel="noopener noreferrer"
          class="link ml-1"
        >
          La Sœur de la Mariée
        </a>
      </p>
      <Button href="/contact#contact">Demander un devis</Button>
    </div>
  </Testimonials>

  <!-- Lecture en grand -->
  <dialog id="film-dialog" class="film-dialog" aria-label="Lecture du film">
    <form method="dialog" class="mb-3 flex justify-end">
      <button class="btn btn-ghost tone-profond" style="background: transparent">Fermer</button>
    </form>
    <div class="frame aspect-video">
      <video id="film-dialog-video" controls playsinline></video>
    </div>
  </dialog>
</Base>

<style>
  /* Le film principal s'ouvre comme un rideau au chargement */
  .hero-frame {
    aspect-ratio: 16 / 9;
    max-height: calc(100svh - var(--header-h) - 14rem);
    min-height: 14rem;
    width: 100%;
    animation: frame-open 1.5s var(--ease-out) both;
  }
</style>

<script>
  const dialog = document.getElementById('film-dialog') as HTMLDialogElement | null;
  const dialogVideo = document.getElementById('film-dialog-video') as HTMLVideoElement | null;
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
  const muteToggle = document.getElementById('mute-toggle');
  const ordinateur = window.matchMedia('(min-width: 768px)');
  const survol = window.matchMedia('(hover: hover)');

  // Film principal : lecture automatique sur ordinateur uniquement
  if (heroVideo && ordinateur.matches) {
    heroVideo.play().catch(() => {});
  }

  muteToggle?.addEventListener('click', () => {
    if (!heroVideo) return;
    heroVideo.muted = !heroVideo.muted;
    muteToggle.setAttribute('aria-pressed', String(!heroVideo.muted));
    muteToggle.textContent = heroVideo.muted ? 'Activer le son' : 'Couper le son';
  });

  // Ouverture d'un film en grand
  document.querySelectorAll<HTMLElement>('[data-film-src]').forEach((declencheur) => {
    const apercu = declencheur.querySelector('video');

    declencheur.addEventListener('click', () => {
      const src = declencheur.dataset.filmSrc;
      if (!dialog || !dialogVideo || !src) return;
      apercu?.pause();
      heroVideo?.pause();
      dialogVideo.src = src;
      dialog.showModal();
      dialogVideo.play().catch(() => {});
    });

    // Aperçu muet au survol
    if (apercu && survol.matches) {
      declencheur.addEventListener('mouseenter', () => apercu.play().catch(() => {}));
      declencheur.addEventListener('mouseleave', () => apercu.pause());
    }
  });

  dialog?.addEventListener('close', () => {
    if (dialogVideo) {
      dialogVideo.pause();
      dialogVideo.removeAttribute('src');
      dialogVideo.load();
    }
    if (heroVideo && ordinateur.matches) heroVideo.play().catch(() => {});
  });

  // Clic en dehors de la vidéo : on ferme
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

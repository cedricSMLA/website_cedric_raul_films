---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Arrow from '@/components/Arrow.astro';

const portrait = [
  {
    titre: "L'œil technique",
    texte:
      "Ma formation d’ingénieur m’a appris à préparer les choses avec précision. Filmer en montagne et dans les sports extrêmes m’a appris à m’adapter quand rien ne se passe comme prévu. Sur un mariage, je m’appuie sur les deux : connaître mon matériel pour pouvoir réagir vite et rester attentif à ce qui se passe autour de moi."
  },
  {
    titre: 'Ma façon de filmer',
    texte:
      "Je vous guide quand c’est utile, notamment pendant les prises de vue à deux. Je vous propose un mouvement ou une position, puis je vous laisse le temps de vous l’approprier. Le reste de la journée, je filme les échanges et ce qui se passe autour de vous en restant discret. Au montage, je travaille le rythme du film pour retrouver l’ambiance que vous avez vécue."
  },
  {
    titre: 'Le résultat',
    texte:
      "Retrouver les voix de vos proches, revoir un discours, découvrir ce qui se passait pendant que vous étiez ailleurs. Au montage, je rassemble ces moments pour raconter votre journée, en laissant autant de place aux échanges qu’à l’ambiance de la fête. Vous retrouvez ce que vous avez vécu, avec aussi quelques scènes qui vous avaient échappé."
  }
];

const suite = [
  {
    href: '/loren',
    titre: "L'univers LOREN",
    texte: "Ce que l'amour révèle au silence"
  },
  {
    href: '/nos-partenaires',
    titre: 'Nos partenaires',
    texte: 'Un réseau de confiance'
  }
];
---

<Base
  title="À propos - Cédric Raúl Films"
  description="Des films de mariage qui provoquent l'émotion. Approche cinématographique, drone FPV, post-production soignée. Paris & worldwide."
>
  <PageHero
    title="Une vision"
    accent="cinématographique"
    lead="Je filme votre mariage au plus près de ce que vous vivez avec vos proches. Je vous guide pendant les prises de vue à deux et reste discret le reste de la journée."
  />

  <!-- Portrait -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="frame aspect-[4/5] lg:sticky lg:top-28 lg:self-start" data-reveal>
        <img
          src="/media/photo/IMG_1094.jpg"
          alt="Cédric Raúl, vidéaste mariage"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div>
        <h2 data-reveal>Qui je suis ?</h2>
        <div class="mt-10 md:mt-14">
          {
            portrait.map((bloc) => (
              <div class="rule border-t py-8" data-reveal>
                <h3>{bloc.titre}</h3>
                <p class="mt-4 max-w-[38rem]">{bloc.texte}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- Signature -->
  <Section tone="foret" width="narrow">
    <figure class="text-center" data-reveal>
      <blockquote class="quote">
        Votre mariage mérite plus qu'un souvenir.<br class="hidden md:block" />
        Il mérite une œuvre.
      </blockquote>
      <figcaption class="mt-8">
        <span class="font-medium">Cédric Raúl</span>
        <span class="muted mt-1 block text-sm">
          Vidéaste mariage cinématographique • Paris & Worldwide
        </span>
      </figcaption>
    </figure>
  </Section>

  <!-- Pour aller plus loin : les deux pages rattachées -->
  <Section tone="sable" size="md">
    <ul class="grid gap-0 md:grid-cols-2 md:gap-12">
      {
        suite.map((page, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a href={page.href} class="suite rule group block border-t py-8">
              <span class="font-serif text-[1.625rem] leading-tight md:text-[2rem]">
                {page.titre}
              </span>
              <span class="muted mt-3 flex items-center justify-between gap-4">
                <span class="font-serif text-lg">{page.texte}</span>
                <span class="suite-fleche accent"><Arrow /></span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaBand
    title="Prêt à raconter"
    accent="votre histoire ?"
    text="Discutons ensemble de votre projet et créons un film qui vous ressemble vraiment."
    primary={{ href: '/contact#contact', label: 'Contactez-nous' }}
  />
</Base>

<style>
  .suite {
    transition: border-color 0.3s ease;
  }

  .suite:hover {
    border-color: var(--cuivre);
  }

  .suite-fleche {
    transition: transform 0.5s var(--ease-out);
  }

  .suite:hover .suite-fleche {
    transform: translateX(0.5rem);
  }
</style>

---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { forfaits, optionLabel } from '@/data/forfaits';
import { EMAIL, INSTAGRAM, DELAI_REPONSE } from '@/data/site';

const promesses = [
  { titre: 'Réponse rapide', texte: `Sous ${DELAI_REPONSE} maximum` },
  { titre: 'Devis gratuit', texte: 'Personnalisé et détaillé' },
  { titre: 'Conseil expert', texte: 'Accompagnement personnalisé' }
];
---

<Base
  title="Contact - Cédric Raúl Films"
  description="Créons ensemble votre film de mariage. Films cinématographiques qui provoquent l'émotion. Basé à Paris, disponible partout ailleurs."
>
  <PageHero
    title="Créons votre film"
    accent="ensemble"
    lead="Un film de mariage qui vous fera revivre chaque émotion, comme si vous y étiez encore."
  />

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-20">
      <!-- Ce à quoi s'attendre -->
      <aside>
        <dl>
          {
            promesses.map((p) => (
              <div class="rule border-t py-5" data-reveal>
                <dt class="font-serif text-xl leading-tight">{p.titre}</dt>
                <dd class="muted mt-1">{p.texte}</dd>
              </div>
            ))
          }
        </dl>
        <div class="rule border-t pt-6" data-reveal>
          <p class="muted text-sm">Vous préférez écrire directement ?</p>
          <p class="mt-2">
            <a href={`mailto:${EMAIL}`} class="link break-all">{EMAIL}</a>
          </p>
          <p class="mt-1">
            <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="link">Instagram</a>
          </p>
        </div>
      </aside>

      <!-- Formulaire -->
      <div id="contact">
        <form id="contact-form" class="tone-sable space-y-7 rounded-md p-6 sm:p-10" data-reveal>
          <h2 class="text-[1.875rem]">Discutons de votre projet</h2>

          <div class="grid gap-7 sm:grid-cols-2">
            <div class="field">
              <label for="nom">Vos noms *</label>
              <input
                type="text"
                id="nom"
                name="nom"
                required
                autocomplete="name"
                class="input"
                placeholder="Marie & Thomas"
              />
            </div>

            <div class="field">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="input"
                placeholder="marie.thomas@email.com"
              />
            </div>
          </div>

          <div class="field">
            <label for="date">Date de votre mariage *</label>
            <input type="date" id="date" name="date" required class="input" />
          </div>

          <div class="field">
            <label for="forfait">
              Choisir un forfait <span class="muted font-normal">(optionnel)</span>
            </label>
            <select id="forfait" name="forfait" class="input">
              <option value="">Préfère ne pas préciser</option>
              {forfaits.map((f) => <option value={f.id}>{optionLabel(f)}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="message">Parlez-nous de votre vision *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="input resize-none"
              placeholder="Décrivez-nous votre mariage, vos attentes, l'ambiance que vous souhaitez..."
              aria-describedby="message-aide"
            ></textarea>
            <p id="message-aide" class="muted mt-2 text-sm">
              Les liens ne sont pas acceptés dans ce formulaire.
            </p>
          </div>

          <!-- Champ piège : invisible pour un humain, rempli par les robots -->
          <div class="piege" aria-hidden="true">
            <label for="site_web">Ne pas remplir ce champ</label>
            <input type="text" id="site_web" name="site_web" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="consent" name="consent" required class="mt-1.5 h-4 w-4 shrink-0" />
            <label for="consent" class="muted text-sm leading-relaxed">
              J'accepte que mes données soient utilisées pour traiter ma demande.
              <a href="/confidentialite" class="link">Politique de confidentialité</a>
            </label>
          </div>

          <button type="submit" id="submit-btn" class="btn btn-solid w-full">Envoyer ma demande</button>

          <div id="form-message" class="form-note hidden" role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const formMessage = document.getElementById('form-message');
  const affichage = performance.now();

  function afficherMessage(texte: string, etat: 'success' | 'error') {
    if (!formMessage) return;
    formMessage.textContent = texte;
    formMessage.dataset.state = etat;
    formMessage.classList.remove('hidden');
    formMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours...';
    formMessage?.classList.add('hidden');

    const formData = new FormData(form);
    const data = {
      nom: formData.get('nom'),
      email: formData.get('email'),
      date: formData.get('date'),
      forfait: formData.get('forfait'),
      message: formData.get('message'),
      consent: formData.get('consent') ? true : false,
      // Anti-robots : champ piège et temps passé sur le formulaire
      site_web: formData.get('site_web'),
      duree: Math.round(performance.now() - affichage)
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();

      if (result.success) {
        afficherMessage(result.message, 'success');
        form.reset();
      } else {
        afficherMessage(result.error || 'Une erreur est survenue.', 'error');
      }
    } catch {
      afficherMessage(
        'Erreur de connexion. Veuillez vérifier votre connexion internet et réessayer.',
        'error'
      );
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer ma demande';
    }
  });

  // Présélection du forfait depuis l'URL (?forfait=ame)
  const forfaitDemande = new URLSearchParams(window.location.search).get('forfait');
  const forfaitSelect = document.getElementById('forfait') as HTMLSelectElement | null;
  if (forfaitDemande && forfaitSelect) {
    const existe = Array.from(forfaitSelect.options).some((o) => o.value === forfaitDemande);
    if (existe) forfaitSelect.value = forfaitDemande;
  }
</script>

---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Arrow from '@/components/Arrow.astro';

const photographes = [
  {
    nom: 'Coraline',
    photo: '/media/photo/Coraline.jpeg',
    texte:
      "Regard sensible, lumière naturelle, instants volés. Coraline capture l'émotion brute avec une approche documentaire subtile et poétique.",
    points: [
      'Reportage photo complet',
      'Style documentaire & artistique',
      'Édition professionnelle soignée'
    ],
    liens: [
      { href: 'https://www.instagram.com/theco.edit/', label: 'Voir son Instagram' },
      { href: 'https://coedit.mypixieset.com/gallery-1/', label: 'Voir son portfolio' }
    ]
  },
  {
    nom: 'Alexys',
    photo: '/media/photo/Alexys.jpg',
    texte:
      "Approche documentaire, émotions brutes, récit visuel. Alexys crée des images qui racontent l'histoire authentique de votre journée.",
    points: [
      'Photojournalisme de mariage',
      'Authenticité & spontanéité',
      'Post-traitement signature'
    ],
    liens: [{ href: 'https://alexyska.mypixieset.com/wedding/', label: 'Voir son portfolio' }]
  }
];

const raisons = [
  {
    titre: 'Harmonie parfaite',
    texte:
      'Photo et vidéo travaillent ensemble, sans se gêner. Une chorégraphie fluide pour capturer tous les moments.'
  },
  {
    titre: 'Des habitudes communes',
    texte:
      "Nous avons déjà travaillé ensemble : chacun connaît les placements et le rythme de l'autre."
  },
  {
    titre: 'Chacun son devis',
    texte:
      'Vous échangez directement avec le photographe de votre choix. Chacun établit son propre devis et sa propre facture.'
  }
];
---

<Base
  title="Nos partenaires - Cédric Raúl Films"
  description="Un réseau de confiance : photographes, lieux, prestataires. Des collaborateurs qui partagent notre vision pour créer des mariages d'exception."
>
  <PageHero
    title="Un réseau"
    accent="de confiance"
    lead="Photographes talentueux, lieux d'exception, prestataires passionnés : des collaborateurs qui partagent notre vision de l'excellence."
  />

  <!-- Philosophie de collaboration -->
  <Section size="md">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <h2 data-reveal>
        La collaboration au cœur du projet
      </h2>
      <p class="max-w-[38rem] text-lg" data-reveal style="--i: 1">
        Un mariage réussi est le fruit d'une collaboration fluide entre tous les prestataires. Je
        travaille avec des professionnels qui partagent ma vision de l'excellence et mon souci du
        détail, pour que votre journée soit parfaitement orchestrée.
      </p>
    </div>
  </Section>

  <!-- Photographes partenaires -->
  <Section tone="sable">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16">
      <h2 data-reveal>Photographes partenaires</h2>
      <p class="lead" data-reveal style="--i: 1">
        Une collaboration fluide avec des artistes qui partagent ma vision. Coordination parfaite
        garantie le jour J.
      </p>
    </div>

    <div class="mt-12 grid gap-16 md:mt-16 md:grid-cols-2 md:gap-12 lg:gap-20">
      {
        photographes.map((p, i) => (
          <article data-reveal style={`--i: ${i}`}>
            <div class="frame photographe aspect-[4/5]">
              <img
                src={p.photo}
                alt={`${p.nom} - Photographe partenaire`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="mt-7 text-[1.875rem]">{p.nom}</h3>
            <p class="muted mt-1 text-sm">Photographe mariage</p>
            <p class="mt-5 max-w-[34rem]">{p.texte}</p>
            <ul class="ticks muted mt-5">
              {p.points.map((point) => <li>{point}</li>)}
            </ul>
            <p class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
              {
                p.liens.map((lien) => (
                  <a href={lien.href} target="_blank" rel="noopener noreferrer" class="link-arrow">
                    {lien.label} <Arrow />
                  </a>
                ))
              }
            </p>
          </article>
        ))
      }
    </div>

    <!-- Mise en relation : chacun reste indépendant -->
    <div
      class="rule mt-16 grid gap-6 border-t pt-10 md:mt-24 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      data-reveal
    >
      <h3>Besoin d'un photographe ?</h3>
      <div>
        <p class="max-w-[38rem] text-lg">
          Je vous mets en relation avec des photographes avec qui j'ai l'habitude de travailler.
          Chacun établit son propre devis et sa propre facture.
        </p>
        <a href="/contact#contact" class="link-arrow mt-6">En savoir plus <Arrow /></a>
      </div>
    </div>
  </Section>

  <!-- Pourquoi des prestataires qui se connaissent -->
  <Section>
    <h2 class="max-w-[22ch]" data-reveal>Pourquoi choisir des prestataires qui se connaissent ?</h2>

    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-12">
      {
        raisons.map((raison, i) => (
          <div class="rule border-t pt-6" data-reveal style={`--i: ${i}`}>
            <h3>{raison.titre}</h3>
            <p class="muted mt-3">{raison.texte}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBand
    title="Prêt à raconter"
    accent="votre histoire ?"
    text="Discutons ensemble de votre projet et créons un film qui vous ressemble vraiment."
    primary={{ href: '/contact#contact', label: 'Contactez-nous' }}
  />
</Base>

<style>
  .photographe img {
    transition: transform 1.6s var(--ease-out);
  }

  article:hover .photographe img {
    transform: scale(1.03);
  }
</style>

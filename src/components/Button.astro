---
export interface Props {
  href?: string;
  variant?: 'solid' | 'ghost';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'solid', class: className = '', ...rest } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element href={href} class:list={['btn', `btn-${variant}`, className]} {...rest}>
  <slot />
</Element>

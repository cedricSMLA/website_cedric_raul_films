---
/**
 * Image de film en pleine largeur, au format cinémascope sur ordinateur.
 * Sert à couper les longues pages de texte avec une vraie image.
 */
export interface Props {
  src: string;
  alt: string;
  /** Légende discrète sous l'image (nom du couple). */
  caption?: string;
  /** Cadrage vertical quand l'image est recadrée, ex. « 50% 35% ». */
  position?: string;
}

const { src, alt, caption, position = '50% 50%' } = Astro.props;
---

<figure class="image-band tone-profond">
  <div class="image-band-cadre">
    <img src={src} alt={alt} loading="lazy" decoding="async" style={`object-position: ${position}`} />
  </div>
  {caption && <figcaption class="wrap muted py-3 text-sm">{caption}</figcaption>}
</figure>

<style>
  .image-band-cadre {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .image-band-cadre img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .image-band-cadre {
      aspect-ratio: 2.39 / 1;
      max-height: 78svh;
      width: 100%;
    }
  }
</style>

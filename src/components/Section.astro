---
export interface Props {
  /** Couleur de fond de la section. */
  tone?: 'ivoire' | 'sable' | 'foret' | 'profond';
  /** Largeur du contenu. */
  width?: 'default' | 'narrow' | 'text';
  size?: 'md' | 'lg';
  class?: string;
  id?: string;
}

const { tone = 'ivoire', width = 'default', size = 'lg', class: className = '', id } = Astro.props;

const wraps = {
  default: 'wrap',
  narrow: 'wrap wrap-narrow',
  text: 'wrap wrap-text'
};
---

<section
  id={id}
  class:list={['section', size === 'md' && 'section-md', tone !== 'ivoire' && `tone-${tone}`, className]}
>
  <div class={wraps[width]}>
    <slot />
  </div>
</section>

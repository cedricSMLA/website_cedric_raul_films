---
import '@/styles/global.css';
import {
  EMAIL,
  INSTAGRAM,
  YOUTUBE,
  TAGLINE,
  LOCALISATION,
  navPrincipale,
  navSecondaire
} from '@/data/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;

const descriptionParDefaut =
  'Cédric Raúl Films - Vidéaste mariage cinématographique, drone FPV. Basé à Paris, disponible partout ailleurs.';
const metaDescription = description || descriptionParDefaut;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image || '/media/video/amelie_cedric_poster.jpg', Astro.site);

// Entrée du menu correspondant à la page courante
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const estActif = (href: string, aussi: string[] = []) =>
  chemin === href || aussi.includes(chemin);

const annee = new Date().getFullYear();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Cédric Raúl Films',
  description:
    'Vidéaste spécialisé dans les films de mariage cinématographiques, avec drone FPV',
  url: 'https://cedricraulfilms.fr',
  logo: 'https://cedricraulfilms.fr/logo.svg',
  image: socialImage.href,
  email: EMAIL,
  priceRange: '€€€',
  address: { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'Place', name: 'International' }
  ],
  serviceType: ['Vidéaste mariage', 'Film de mariage', 'Drone FPV'],
  founder: { '@type': 'Person', name: 'Cédric Raúl' },
  sameAs: [INSTAGRAM, YOUTUBE]
};

// Analytics
const plausibleDomain = import.meta.env.PLAUSIBLE_DOMAIN;
const plausibleSrc = import.meta.env.PLAUSIBLE_SRC || 'https://plausible.io/js/script.js';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#F5F2EA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={socialImage} />

    <title>{title}</title>

    <!-- Les animations d'apparition ne s'activent que si le script tourne -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {plausibleDomain && <script defer data-domain={plausibleDomain} src={plausibleSrc} />}
  </head>
  <body>
    <a
      href="#contenu"
      class="btn btn-solid sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50"
    >
      Aller au contenu
    </a>

    <header class="site-header" id="header">
      <div class="wrap site-header-inner">
        <a href="/" class="wordmark" aria-label="Cédric Raúl Films, accueil">Cédric Raúl Films</a>

        <!-- Menu ordinateur -->
        <nav class="hidden items-center gap-9 md:flex" aria-label="Navigation principale">
          {
            navPrincipale.map((item) => (
              <a
                href={item.href}
                class="nav-link"
                aria-current={estActif(item.href, item.aussi) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a href="/contact" class="btn btn-solid">Contact</a>
        </nav>

        <!-- Bouton menu mobile -->
        <button
          type="button"
          class="label -mr-2 px-2 py-3 md:hidden"
          id="menu-btn"
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          Menu
        </button>
      </div>
    </header>

    <!-- Menu mobile -->
    <div class="menu-panel md:hidden" id="menu-panel">
      <nav class="wrap flex min-h-full flex-col justify-between pb-10 pt-8" aria-label="Menu">
        <ul class="space-y-1">
          {
            navPrincipale.map((item, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={item.href}
                  class="block py-2 font-serif text-[2rem] leading-tight"
                  aria-current={estActif(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            navSecondaire.map((item, i) => (
              <li style={`--i: ${navPrincipale.length + i}`}>
                <a href={item.href} class="muted block py-2 font-serif text-xl">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="mt-10">
          <li style={`--i: ${navPrincipale.length + navSecondaire.length}`}>
            <a href="/contact" class="btn btn-solid w-full">Contact</a>
            <p class="muted mt-5 text-center text-sm">{LOCALISATION}</p>
          </li>
        </ul>
      </nav>
    </div>

    <main id="contenu">
      <slot />
    </main>

    <footer class="tone-profond">
      <div class="wrap grid gap-12 py-16 md:grid-cols-[minmax(0,5fr)_minmax(0,3fr)_minmax(0,3fr)] md:py-20">
        <div>
          <p class="wordmark" style="color: var(--ivoire)">Cédric Raúl Films</p>
          <p class="mt-5 max-w-xs font-serif text-xl leading-snug">{TAGLINE}</p>
          <p class="muted mt-4 text-sm">{LOCALISATION}</p>
        </div>

        <nav aria-label="Pied de page">
          <ul class="space-y-2.5">
            {
              [...navPrincipale, ...navSecondaire, { href: '/contact', label: 'Contact' }].map(
                (item) => (
                  <li>
                    <a href={item.href} class="hover:text-cuivre-clair transition-colors">
                      {item.label}
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </nav>

        <ul class="space-y-2.5">
          <li>
            <a href={`mailto:${EMAIL}`} class="hover:text-cuivre-clair break-all transition-colors">
              {EMAIL}
            </a>
          </li>
          <li>
            <a
              href={INSTAGRAM}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cuivre-clair transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href={YOUTUBE}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cuivre-clair transition-colors"
            >
              YouTube
            </a>
          </li>
        </ul>
      </div>

      <div class="wrap">
        <div
          class="rule muted flex flex-col gap-2 border-t py-6 text-sm md:flex-row md:items-center md:justify-between"
        >
          <p>&copy; {annee} Cédric Raúl Films. Tous droits réservés.</p>
          <p class="flex gap-6">
            <a href="/confidentialite" class="hover:text-ivoire transition-colors">
              Politique de confidentialité
            </a>
            <span>by SMLEYE Prod</span>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const racine = document.documentElement;

      // Filet sous l'en-tête dès que la page a défilé
      const header = document.getElementById('header');
      const marquerDefilement = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
      marquerDefilement();
      window.addEventListener('scroll', marquerDefilement, { passive: true });

      // Menu mobile
      const menuBtn = document.getElementById('menu-btn');
      const basculerMenu = (ouvrir: boolean) => {
        racine.toggleAttribute('data-menu-open', ouvrir);
        menuBtn?.setAttribute('aria-expanded', String(ouvrir));
        if (menuBtn) menuBtn.textContent = ouvrir ? 'Fermer' : 'Menu';
        document.body.style.overflow = ouvrir ? 'hidden' : '';
      };
      menuBtn?.addEventListener('click', () =>
        basculerMenu(!racine.hasAttribute('data-menu-open'))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && racine.hasAttribute('data-menu-open')) {
          basculerMenu(false);
          menuBtn?.focus();
        }
      });
      window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) basculerMenu(false);
      });

      // Apparition au défilement : une seule fois par élément
      const aReveler = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observateur = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((entree) => {
              if (entree.isIntersecting) {
                entree.target.classList.add('is-in');
                observateur.unobserve(entree.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        aReveler.forEach((el) => observateur.observe(el));
      } else {
        aReveler.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

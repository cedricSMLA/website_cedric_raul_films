[Unit]
Description=Cedric Raul Films Website
After=network.target

[Service]
Type=simple
User=smleye
WorkingDirectory=/home/smleye/website_cedric_raul_films
ExecStart=/usr/bin/node --preserve-symlinks ./dist/server/entry.mjs
Restart=always
RestartSec=10

# Variables d'environnement
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=4321
Environment=SITE_URL=https://cedricraulfilms.fr

# Configuration SMTP : jamais de secret dans ce fichier (il est versionné).
# Le fichier ci-dessous est créé sur le serveur (root:smleye, chmod 640) et contient :
#   SMTP_HOST=smtp.protonmail.ch
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=contact@cedricraulfilms.fr
#   SMTP_PASS=<token SMTP Proton>
#   CONTACT_EMAIL=contact@cedricraulfilms.fr
EnvironmentFile=/etc/cedric-raul/app.env

# Logs
StandardOutput=append:/var/log/cedric-raul/app.log
StandardError=append:/var/log/cedric-raul/error.log

[Install]
WantedBy=multi-user.target
